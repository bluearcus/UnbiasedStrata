#!/bin/sh
# Short entry point for the LACT fan tool.  Edits /etc/lact/config.yaml, so it elevates itself when not root -
# loudly, because silently gaining root is exactly what nobody wants to discover later.
SCRIPT=/home/mike/Sync/Projects/StrataUnbiasedDualGPU/UnbiasedStrata/tools/lact/fan_pin.py
if [ "$(id -u)" -ne 0 ]; then
    echo "fanpin: needs root to edit /etc/lact/config.yaml - elevating with sudo" >&2
    exec sudo python3 "$SCRIPT" "$@"
fi
exec python3 "$SCRIPT" "$@"
